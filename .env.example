# このファイルを .env にコピーして値を編集してください
# cp .env.example .env

# データベース: 無料のクラウドDB「Turso」を使う場合に設定（未設定ならローカルファイルを使用）
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# LINE通知（任意機能）: 設定するとお客様の注文時にLINEへ通知が届きます
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# 管理画面の初回ログイン用アカウント（初回起動時に自動作成されます）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# セッションの暗号化に使う適当な長い文字列（本番では必ず変更してください）
SESSION_SECRET=please-change-this-to-a-long-random-string

# ポート番号（ホスティング先が指定する場合はそちらが優先されます）
PORT=3000

NODE_ENV=production
